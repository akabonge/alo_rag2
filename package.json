{
  "name": "ai-alo-3d",
  "version": "0.1.0",
  "private": true,
  "description": "AI Alo 3D portfolio: interactive Three.js journey with grounded AI answers",
  "scripts": {
    "dev": "npx --yes serve src -l 5173",
    "build:page": "python test/wrap.py && node test/make_text.mjs",
    "test": "node --test test/*.test.mjs scripts/audit/audit-tools.test.mjs",
    "test:browser": "node test/browser-smoke.cjs",
    "test:experience": "node test/experience-browser.cjs",
    "site:audit": "node scripts/audit/site-audit.mjs",
    "site:audit:phones": "node scripts/audit/site-audit.mjs --quick",
    "roadmap:issues": "node scripts/roadmap/issues.mjs"
  },
  "dependencies": {
    "three": "0.186.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  },
  "type": "module"
}
